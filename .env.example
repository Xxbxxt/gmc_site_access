# Copy to .env and set your local values (never commit .env)
POSTGRES_USER=gmc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gmc_site_access

# Password must match POSTGRES_PASSWORD above
DATABASE_URL=postgresql://gmc:change-me@localhost:5433/gmc_site_access

# Auth.js (next-auth v5)
AUTH_SECRET=              # generate: npx auth secret
AUTH_URL=http://localhost:3000

# Microsoft Entra ID sign-in provider (Auth.js auto-wires AUTH_MICROSOFT_ENTRA_ID_* vars)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=   # https://login.microsoftonline.com/<tenant-id>/v2.0

# Microsoft Graph client-credentials flow (src/lib/azure/graph-mail.ts — separate from sign-in above)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GRAPH_SENDER_EMAIL=       # licensed M365 mailbox; app registration needs Mail.Send (Application, admin-consented)

# Seed script — first System Admin (src/lib/db/seed.ts)
SEED_ADMIN_ENTRA_ID=      # your Entra Object ID
SEED_ADMIN_EMAIL=

# Azure Blob Storage (src/lib/azure/blob.ts) — shared-key auth via connection
# string (Storage account → Access keys → Connection string). Container is
# created automatically on first upload if it doesn't exist yet.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=documents
